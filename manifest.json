{
  "schemaVersion": 1,
  "id": "io.github.limbdarkening.softether",
  "name": "SoftEther VPN",
  "version": "0.2.2",
  "author": "LimbDarkening",
  "license": "MIT",
  "description": "Minimal SoftEther VPN shield with quick toggle and country switching.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "SoftEther VPN",
    "description": "Toggle SoftEther and choose an imported country.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "accountName": "",
      "adapterName": "vpn_vpn",
      "networkProfileName": "SoftEther VPN Network",
      "refreshIntervalSec": 10
    },
    "schema": [
      {
        "key": "accountName",
        "type": "string",
        "label": "Preferred SoftEther account"
      },
      {
        "key": "adapterName",
        "type": "string",
        "label": "Linux virtual adapter"
      },
      {
        "key": "networkProfileName",
        "type": "string",
        "label": "NetworkManager profile"
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 10
      }
    ]
  }
}
